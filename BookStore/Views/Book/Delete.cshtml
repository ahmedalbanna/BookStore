@model Bookstore.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container">
    <h2 class="mb-4">Delete Book</h2>
    <h3>Are you sure you want to delete this book?</h3>
    <div>
        <h4 class="text-warning">@Model.Title</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Author.AuthorName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Author.AuthorName)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Genre)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Genre)
            </dd>
        </dl>

                <form asp-action="DeleteConfirmed" asp-route-id="@Model.BookId" method="post">
            <input type="hidden" asp-for="BookId" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>