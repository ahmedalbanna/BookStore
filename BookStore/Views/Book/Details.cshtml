@model Bookstore.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.ImageUrl" class="img-fluid" alt="@Model.Title">
        </div>
        <div class="col-md-6">
            <h2>@Model.Title</h2>
            <p>By: @Model.Author.AuthorName</p>
            <p>Genre: @Model.Genre</p>
            <p>Price: @Model.Price.ToString("C")</p>
            <p>@Model.Author.Biography</p>
            
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Books</a>
        </div>
    </div>
</div>