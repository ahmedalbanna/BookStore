@model Bookstore.Models.Author

@{
    ViewData["Title"] = "Delete Author";
}

<div class="container">
    <h2 class="mb-4">Delete Author</h2>
    <h3>Are you sure you want to delete this?</h3>
    <div>
        <h4>@Model.AuthorName</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.AuthorName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.AuthorName)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Biography)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Biography)
            </dd>
        </dl>
        <form asp-action="DeleteConfirmed" asp-route-id="@Model.AuthorId" method="post">
            <input type="hidden" asp-for="AuthorId" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>