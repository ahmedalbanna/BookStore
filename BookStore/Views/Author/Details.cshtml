@model Bookstore.Models.Author

@{
    ViewData["Title"] = "Author Details";
}

<div class="container">
    <h2 class="mb-4">@Model.AuthorName</h2>

    <div class="row">
        <div class="col-md-6">
            <p><strong>Biography:</strong></p>
            <p>@Model.Biography</p>
        </div>
        <div class="col-md-6">
            <h4>Books by @Model.AuthorName:</h4>
            @if (Model.Books.Any())
            {
                <ul>
                    @foreach (var book in Model.Books)
                    {
                        <li>
                            <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId">@book.Title</a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p>No books found for this author.</p>
            }
        </div>
    </div>

    <a asp-action="Index" class="btn btn-secondary">Back to Authors</a>
</div>